# ============================================
# PROGRAMACION II - Proyectos y Subproyectos
# Python / Odoo / Django
# ============================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Entornos virtuales
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# ----- IDE / Editores -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Sistema operativo -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Python packaging -----
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.whl

# ----- Jupyter -----
.ipynb_checkpoints/

# ============================================
# DJANGO
# ============================================

# Base de datos local
*.sqlite3

# Archivos generados por Django
staticfiles/
media/
*.log

# Archivos temporales
*.pid

# ============================================
# ODOO
# ============================================

# Logs
*.log

# Archivos generados / temporales de Odoo
*.pyc
*.pyo

# Filestore local de Odoo
filestore/

# Configuraciones locales que pueden contener contraseñas
*.conf
*.ini

# IMPORTANTE:
# Si necesitas guardar un archivo de configuración de ejemplo,
# utiliza un nombre como:
# odoo.conf.example

# ============================================
# DATOS SENSIBLES
# ============================================

# Certificados y claves privadas
*.pem
*.key
*.crt

# Archivos locales con credenciales
secrets.json
credentials.json

# ============================================
# PROYECTOS DE PROGRAMACION II
# ============================================

# Carpetas temporales de cada proyecto
*/temp/
*/tmp/
*/backup/
*/backups/

# Archivos de salida generados
*.tmp
*.temp
*.bak

# NO se ignoran:
# .py
# .html
# .css
# .js
# .xml
# .csv
# .json
# .md
# Estos archivos forman parte de los proyectos y Git debe controlarlos.